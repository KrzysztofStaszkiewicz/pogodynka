{% extends 'base.html.twig' %}

{% block title %}Measurement{% endblock %}

{% block body %}
    <h1>Measurement</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ measurement.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ measurement.Date ? measurement.Date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ measurement.Temperature }}</td>
            </tr>
            <tr>
                <th>Wind</th>
                <td>{{ measurement.Wind }}</td>
            </tr>
            <tr>
                <th>Cloudiness</th>
                <td>{{ measurement.Cloudiness }}</td>
            </tr>
            <tr>
                <th>Precipitation</th>
                <td>{{ measurement.Precipitation }}</td>
            </tr>
        </tbody>
    </table>
    {% if is_granted('ROLE_MEASUREMENT_INDEX') %}
        <a href="{{ path('app_measurement_index') }}">back to list</a>
    {% endif %}

    {% if is_granted('ROLE_MEASUREMENT_EDIT') %}
        <a href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">edit</a>
    {% endif %}

    {% if is_granted('ROLE_MEASUREMENT_DELETE') %}
        {{ include('measurement/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
