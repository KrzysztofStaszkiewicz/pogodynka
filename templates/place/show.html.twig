{% extends 'base.html.twig' %}

{% block title %}Place{% endblock %}

{% block body %}
    <h1>Place</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ place.id }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ place.Country }}</td>
            </tr>
            <tr>
                <th>City</th>
                <td>{{ place.City }}</td>
            </tr>
            <tr>
                <th>Latitude</th>
                <td>{{ place.Latitude }}</td>
            </tr>
            <tr>
                <th>Longitude</th>
                <td>{{ place.Longitude }}</td>
            </tr>
        </tbody>
    </table>

    {%  if is_granted('ROLE_PLACE_INDEX') %}
        <a href="{{ path('app_place_index') }}">back to list</a>
    {% endif %}

    {% if is_granted('ROLE_PLACE_EDIT') %}
        <a href="{{ path('app_place_edit', {'id': place.id}) }}">edit</a>
    {% endif %}

    {% if is_granted('ROLE_PLACE_DELETE') %}
        {{ include('place/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
